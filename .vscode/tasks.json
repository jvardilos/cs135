{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build active file",
            "type": "shell",
            "command": "mkdir -p \"${workspaceFolder}/.build/${relativeFileDirname}\" && clang++ -std=c++20 -g -O0 -Wall -Wextra -fcolor-diagnostics -fansi-escape-codes \"${file}\" -o \"${workspaceFolder}/.build/${relativeFileDirname}/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "presentation": {
                "reveal": "silent",
                "clear": true,
                "panel": "shared"
            },
            "detail": "clang++ -std=c++20 -g, output into .build/"
        },
        {
            "label": "run active file",
            "type": "shell",
            "command": "\"${workspaceFolder}/.build/${relativeFileDirname}/${fileBasenameNoExtension}\"",
            "options": {
                "cwd": "${fileDirname}"
            },
            "dependsOn": "build active file",
            "problemMatcher": [],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "presentation": {
                "reveal": "always",
                "clear": true,
                "panel": "dedicated",
                "focus": true
            },
            "detail": "Build, then run in the terminal (no debugger)"
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/usr/bin/clang++",
            "args": [
                "-fcolor-diagnostics",
                "-fansi-escape-codes",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        }
    ]
}